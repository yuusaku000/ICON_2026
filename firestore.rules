rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      // 一覧は誰でも見られる
      allow read: if true;
      // 書き換えられるのは管理者アカウントだけ（firebase-config.js の adminEmail と同じにする）
      allow write: if request.auth != null
        && request.auth.token.email == "takakura.yusaku.25@shizuoka.ac.jp";
    }
  }
}
